{
  "name": "dsh-witty",
  "version": "1.0.0",
  "description": "Witty：逐句英语打字与翻译、考研阅读出题、AI 精读、作文训练与收藏夹（DeepSeek Harness 插件）。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "english",
    "typing",
    "translation",
    "essay",
    "favorites"
  ],
  "homepage": "https://github.com/xeoriam/witty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeoriam/witty.git"
  },
  "bugs": {
    "url": "https://github.com/xeoriam/witty/issues"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build.mjs",
    "src/**/*.js",
    "vendor/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "USAGE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "mammoth": "1.13.0"
  }
}
